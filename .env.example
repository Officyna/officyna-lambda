# Ambiente
NODE_ENV=development
PORT=3001

# Banco de Dados (MongoDB Local via Docker Compose ou DocumentDB AWS)
MONGODB_URI=mongodb://localhost:27017/officyna
DB_NAME=officyna
DOCDB_TLS=false

# Segredo JWT (deve ser idêntico ao officyna-service e Kong)
JWT_SECRET=officyna-secret-key-change-in-production-min-256bits
JWT_ISSUER=officyna-auth
JWT_EXPIRATION=86400000
