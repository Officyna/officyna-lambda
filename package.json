{
  "name": "officyna-lambda",
  "version": "1.0.0",
  "description": "AWS Lambda Serverless Function para autenticação de clientes por CPF e geração de JWT",
  "main": "dist/index.js",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --outfile=dist/index.js --external:mongodb-client-encryption --external:aws-crt --external:snappy --external:@aws-sdk/* --external:@mongodb-js/zstd --external:kerberos --external:socks",
    "build:local": "esbuild src/local.ts --bundle --platform=node --target=node20 --outfile=dist/local.js --external:mongodb-client-encryption --external:aws-crt --external:snappy --external:@aws-sdk/* --external:@mongodb-js/zstd --external:kerberos --external:socks",
    "start:local": "npm run build:local && node dist/local.js",
    "dev": "npm run start:local",
    "test": "jest --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist coverage lambda.zip"
  },
  "keywords": [
    "serverless",
    "aws-lambda",
    "auth",
    "jwt",
    "documentdb",
    "mongodb",
    "kong",
    "officyna"
  ],
  "author": "Officyna Team",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^16.4.7",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.14.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.147",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.9",
    "esbuild": "^0.25.0",
    "jest": "^29.7.0",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.2.6",
    "typescript": "^5.8.2"
  }
}
